generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EmailStatus {
  SCHEDULED
  PROCESSING
  SENT
  FAILED
}

model User {
  id        String   @id @default(cuid())
  googleId  String   @unique
  name      String
  email     String   @unique
  avatarUrl String?

  senders        Sender[]
  campaigns      EmailCampaign[]
  emails         Email[]
  slackConnection SlackConnection?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Sender {
  id      String @id @default(cuid())
  userId  String

  email String
  name  String

  // Default scheduling controls for this sender
  delayBetweenEmailsMs Int @default(2000)
  hourlyLimit          Int @default(200)

  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaigns EmailCampaign[]
  emails    Email[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, email])
  @@index([userId])
}

model EmailCampaign {
  id       String @id @default(cuid())
  userId   String
  senderId String

  name String?

  subject String
  body    String

  startTime            DateTime
  delayBetweenEmailsMs Int
  hourlyLimit          Int

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  sender Sender @relation(fields: [senderId], references: [id], onDelete: Restrict)

  emails Email[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([senderId])
}

model Email {
  id         String @id @default(cuid())
  userId     String
  senderId   String
  campaignId String

  recipient String
  subject   String
  body      String

  sequence Int

  scheduledAt       DateTime
  originalScheduledAt DateTime
  sentAt            DateTime?

  status        EmailStatus @default(SCHEDULED)
  failureReason String?

  // BullMQ tracking
  jobId String @unique

  // Prevent duplicate processing/sending
  idempotencyKey String @unique

  attemptCount Int @default(0)

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  sender   Sender       @relation(fields: [senderId], references: [id], onDelete: Restrict)
  campaign EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([senderId, status])
  @@index([campaignId, sequence])
  @@index([scheduledAt])
  @@index([sentAt])
  @@index([recipient])
}

model SlackConnection {
  id String @id @default(cuid())

  userId String @unique

  accessToken String
  teamId      String?
  teamName    String?
  channelId   String?
  channelName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}